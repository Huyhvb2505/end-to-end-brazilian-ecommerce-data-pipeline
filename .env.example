# --- JUPYTER CONFIG ---
JUPYTER_PORT=8888
JUPYTER_TOKEN=your_jupyter_token

# --- POSTGRES CONFIG ---
POSTGRES_PORT=5432
POSTGRES_DB=your_name_DB
POSTGRES_USER=your_name_user
POSTGRES_PASSWORD=your_pass
AIRFLOW_DB_NAME=your_name_airflow_DB

# --- MINIO CONFIG ---
MINIO_HOST=localhost # set =minio if run env docker 
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=your_user_name
MINIO_ROOT_PASSWORD=your_pass

# --- BUCKETS CONFIG ---
BUCKET_RAW=raw-data
BUCKET_PROCESSED=processed-data
BUCKET_MODELS=ml-models

# --- AIRFLOW CONFIG ---
AIRFLOW_IMAGE_NAME=apache/airflow:2.8.1-python3.10
AIRFLOW_UID=50000
_AIRFLOW_WWW_USER_USERNAME=your_user_airflow
_AIRFLOW_WWW_USER_PASSWORD=your_pass_airflow
